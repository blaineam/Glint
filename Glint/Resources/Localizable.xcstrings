    "Writes detailed DDC and audio routing info to a log file for troubleshooting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt detaillierte Informationen zu DDC und Audio-Routing zur Fehlersuche in eine Protokolldatei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe información detallada de DDC y del enrutamiento de audio en un archivo de registro para solucionar problemas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit des informations détaillées sur le DDC et le routage audio dans un fichier journal pour le dépannage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive informazioni dettagliate su DDC e instradamento audio in un file di log per la risoluzione dei problemi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラブルシューティング用に、DDC とオーディオルーティングの詳細情報をログファイルに書き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제 해결을 위해 자세한 DDC 및 오디오 라우팅 정보를 로그 파일에 기록합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava informações detalhadas de DDC e roteamento de áudio em um arquivo de registro para solução de problemas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将详细的 DDC 和音频路由信息写入日志文件，以便排查问题。"
          }
        }
      }
    },
